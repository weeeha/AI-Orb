{
  "name": "ai-orb",
  "version": "0.1.0",
  "description": "An audio-reactive orb for AI voice interfaces. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "docs/style-guide.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "harness:pack": "node harness/pack.mjs",
    "harness:install": "npm run harness:pack && cd harness/consumer && rm -rf node_modules/ai-orb && npm install --no-package-lock --no-audit --no-fund",
    "harness:build": "cd harness/consumer && npm run build",
    "harness:smoke": "cd harness/consumer && npm run smoke",
    "harness": "npm run harness:install && npm run harness:build && npm run harness:smoke"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "keywords": [
    "orb",
    "webgl",
    "shader",
    "voice",
    "ai",
    "react",
    "audio-reactive"
  ]
}
