    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
